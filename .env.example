# Kopiér til .env og udfyld. Noeglen er den offentlige (publishable) fra
# Supabase -> Project Settings -> API. Den maa gerne staa i en browser.
#
# Brug IKKE den gamle VITE_SUPABASE_ANON_KEY i nye opsaetninger. Den udfases af
# Supabase ved udgangen af 2026. Koden laeser den stadig som reserve, men kun for at
# en gammel opsaetning ikke braekker fra det ene oejeblik til det andet.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
